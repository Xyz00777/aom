# OS
Thumbs.db

# graphify-out: ignore everything, whitelist only the files needed for
# `graphify query/path/explain` to work in a fresh clone.
graphify-out/*
# Required for query/path/explain to work after fresh clone:
!graphify-out/graph.json
!graphify-out/.graphify_labels.json
!graphify-out/.graphify_analysis.json
!graphify-out/.graphify_semantic_marker
# Optional regenerable artifacts (kept in sync by the pre-commit hook or
# regenerated on demand via `graphify cluster-only .`):
!graphify-out/GRAPH_TREE.html
!graphify-out/GRAPH_REPORT.md
!graphify-out/graph.html
!graphify-out/wiki/
# Date-stamped pre-overwrite backup dirs (created by graphify cluster-only):
graphify-out/20??-??-??/

# pytest-testmon per-machine coverage DB (pre-push hook)
.testmondata*
