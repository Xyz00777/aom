{
  "permissions": {
    "allow": [
      "Bash(uv sync:*)",
      "Bash(uv run:*)",
      "Bash(uv pip:*)",
      "Bash(git:*)",
      "Bash(ansible-galaxy:*)",
      "Bash(ansible-playbook:*)",
      "Bash(mkdir:*)",
      "Bash(rm:*)",
      "Read",
      "Write",
      "Edit",
      "Glob",
      "Grep",
      "WebSearch",
      "WebFetch"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "f=$(jq -r '.tool_input.file_path // .tool_response.filePath // empty'); case \"$f\" in *.py) uv run ruff format --check \"$f\" >/dev/null 2>&1 && uv run ruff check \"$f\" >/dev/null 2>&1 ;; esac"
          }
        ]
      }
    ]
  },
  "env": {
    "ANSIBLE_STDOUT_CALLBACK": "ansible.posix.jsonl"
  }
}
